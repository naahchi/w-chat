:root{color-scheme:dark;--app:#0b141a;--panel:#111b21;--muted:#8696a0;--green:#005c4b;--out:#005c4b;--in:#202c33;--text:#e9edef;--blue:#53bdeb}*{box-sizing:border-box}body{margin:0;background:#071015;color:var(--text);font:14px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif}.app-shell{min-height:100dvh;display:grid;grid-template-columns:minmax(320px,480px) minmax(340px,500px);justify-content:center;gap:22px;padding:22px}.phone{height:min(920px,calc(100dvh - 44px));min-height:540px;background:#0b141a;display:flex;flex-direction:column;overflow:hidden;border:1px solid #26343b;border-radius:18px;box-shadow:0 20px 60px #0007}.topbar{height:74px;flex-shrink:0;background:#202c33;display:flex;align-items:center;gap:10px;padding:0 12px}.icon-btn{border:0;background:transparent;color:#e9edef;font-size:27px;min-width:28px;cursor:pointer}.back{font-size:36px;line-height:1}.avatar-wrap{width:42px;height:42px;border-radius:50%;overflow:hidden;flex-shrink:0;cursor:pointer}.avatar-wrap img{width:100%;height:100%;object-fit:cover}.profile{min-width:0;flex:1}.profile-name{font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.last-seen{font-size:12px;color:#b5c1c6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-area{flex:1;overflow-y:auto;padding:18px 12px 12px;background-color:var(--app);background-image:radial-gradient(circle at 18% 25%,#ffffff08 1px,transparent 1.5px),radial-gradient(circle at 80% 70%,#ffffff08 1px,transparent 1.5px);background-size:28px 28px}.messages{display:flex;flex-direction:column;gap:4px;min-height:100%;justify-content:flex-end}.date-separator{align-self:center;margin:14px 0 12px;background:#182229;color:#aebac0;border-radius:8px;padding:6px 12px;font-weight:600;font-size:12px;box-shadow:0 1px 1px #0002}.message-row{display:flex;width:100%;margin:1px 0}.message-row.in{justify-content:flex-start}.message-row.out{justify-content:flex-end}.bubble{position:relative;max-width:86%;min-width:58px;border-radius:9px;padding:7px 8px 5px;font-size:var(--bubble-size,16px);line-height:1.28;overflow-wrap:anywhere;white-space:pre-wrap;box-shadow:0 1px 1px #0002}.in .bubble{background:#202c33;border-top-left-radius:3px}.out .bubble{background:#005c4b;border-top-right-radius:3px}.bubble-text{padding-right:3px}.bubble-meta{float:right;display:flex;gap:3px;align-items:center;margin:7px 0 -1px 10px;color:#a9bec6;font-size:10px;white-space:nowrap}.ticks{font-size:14px;letter-spacing:-4px;padding-right:3px;color:#a9bec6}.ticks.read{color:#53bdeb}.composer{min-height:70px;display:flex;align-items:center;gap:10px;background:#0b141a;padding:8px 10px max(8px,env(safe-area-inset-bottom))}.composer-field{min-width:0;flex:1;display:flex;align-items:center;gap:7px;background:#202c33;border-radius:28px;padding:0 10px;min-height:48px}.composer input{min-width:0;flex:1;width:100%;border:0;background:transparent;padding:11px 0;color:#e9edef;font:16px system-ui;outline:none}.composer-icon{flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;border:0;background:transparent;color:#aebac0;font-size:24px;line-height:1;cursor:pointer;padding:4px;min-width:28px;min-height:34px}.emoji-icon{font-size:25px}.attach{font-size:29px;transform:rotate(-35deg)}.rupee{border:2px solid #71818a;border-radius:50%;font-size:16px;font-weight:600;width:27px;height:27px;min-width:27px;min-height:27px;padding:0}.camera{font-size:25px}.send-btn{position:relative;flex-shrink:0;border:0;background:#00c66a;color:#062a24;width:48px;height:48px;border-radius:50%;font-size:25px;cursor:pointer;display:flex;align-items:center;justify-content:center}.mic-btn{font-size:0}.mic-btn:before{content:"";display:block;width:9px;height:19px;background:#063b2b;border-radius:8px;box-shadow:0 12px 0 -3px #063b2b}.mic-btn:after{content:"";position:absolute;width:18px;height:17px;border:2px solid #063b2b;border-top:0;border-radius:0 0 12px 12px;transform:translateY(3px)}.control-panel{align-self:start;background:#101a20;border:1px solid #26343b;border-radius:18px;padding:22px;max-height:calc(100dvh - 44px);overflow:auto}.panel-heading{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.eyebrow{font-size:10px;letter-spacing:1.6px;color:#00a884;font-weight:800;margin:0 0 5px}.panel-heading h1{font-size:26px;margin:0}.subheading{color:#9cabb2;margin:6px 0 18px}.text-button{background:none;border:0;color:#00c59a;cursor:pointer;padding:8px}.panel-tabs{display:flex;gap:5px;border-bottom:1px solid #293940;margin-bottom:18px}.tab{border:0;background:transparent;color:#9cabb2;padding:10px 12px;cursor:pointer;border-bottom:2px solid transparent}.tab.active{color:#00c59a;border-color:#00a884}.tab-content{display:none}.tab-content.active{display:block}.section-title{display:flex;justify-content:space-between;align-items:center;margin:8px 0 12px}.section-title h2{font-size:15px;margin:0}.hint,.small-note,.footer-note{color:#8fa0a8;font-size:11px}.field-label{display:flex;flex-direction:column;gap:6px;font-size:12px;color:#b6c4ca;margin-bottom:13px}.field-label input:not([type=file]):not([type=color]),.field-label select,.field-label textarea{width:100%;min-width:0;background:#202c33;border:1px solid #34454e;border-radius:8px;color:#e9edef;padding:10px;font:13px system-ui;outline:none}.field-label input:focus,.field-label select:focus,.field-label textarea:focus{border-color:#00a884}.field-label input[type=file]{font-size:11px;max-width:100%;color:#9fb0b7}.field-label input[type=color]{height:38px;width:100%;background:#202c33;border:1px solid #34454e;border-radius:8px;padding:4px}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:10px}.primary-btn,.secondary-btn,.danger-btn{border:0;border-radius:8px;padding:10px 12px;font-weight:650;cursor:pointer;font-size:12px}.primary-btn{background:#00a884;color:#042d25}.secondary-btn{background:#263840;color:#d9e2e6}.danger-btn{background:#5a292b;color:#ffd9d9}.primary-btn:active,.secondary-btn:active{transform:scale(.99)}#addMessageBtn{width:100%;margin:0 0 18px}.list-title{border-top:1px solid #293940;padding-top:17px}.message-list{display:flex;flex-direction:column;gap:7px}.message-item{display:flex;align-items:center;gap:8px;background:#1b282f;padding:9px;border-radius:9px}.message-item-main{min-width:0;flex:1}.message-item-text{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.message-item-meta{font-size:10px;color:#8fa0a8;margin-top:3px}.message-item button{border:0;border-radius:6px;background:#31434b;color:#e9edef;padding:6px 8px;font-size:11px;cursor:pointer}.small-note{line-height:1.55;margin:13px 0}.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #293940;font-size:12px;color:#c4d0d5}.toggle-row input{accent-color:#00a884;width:17px;height:17px}.panel-footer{display:flex;gap:8px;margin-top:18px}.panel-footer button{flex:1}.footer-note{line-height:1.5;margin:13px 0 0}.modal{position:fixed;inset:0;background:#000a;display:flex;align-items:center;justify-content:center;padding:16px;z-index:5}.modal[hidden]{display:none}.modal-card{width:min(470px,100%);background:#101a20;border:1px solid #34454e;border-radius:16px;padding:20px;box-shadow:0 20px 60px #0009}.modal-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.modal-heading h2{font-size:18px;margin:0}.modal-actions{display:flex;gap:8px;margin-top:14px}.modal-actions .danger-btn{margin-right:auto}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#e6f4ef;color:#07382e;padding:10px 16px;border-radius:9px;box-shadow:0 5px 25px #0005;transition:.2s;z-index:10;font-size:13px}.toast.show{opacity:1;transform:translate(-50%,0)}body.light{--app:#efeae2;--text:#111b21;color-scheme:light}body.light .chat-area{background-image:radial-gradient(circle at 18% 25%,#64746a10 1px,transparent 1.5px),radial-gradient(circle at 80% 70%,#64746a10 1px,transparent 1.5px)}body.light .date-separator{background:#f7f3ec;color:#5d686e}body.light .in .bubble{background:#fff;color:#111b21}body.light .out .bubble{background:#d9fdd3;color:#111b21}body.light .bubble-meta{color:#68777e}body.light .composer{background:#efeae2}body.light .composer input{background:#fff;color:#111b21}body.light .topbar{background:#f0f2f3;color:#111b21}body.light .topbar .icon-btn{color:#111b21}body.light .profile-name{color:#111b21}body.light .last-seen{color:#65757c}body.light .phone{border-color:#d0d8dc}
@media(max-width:800px){.composer{gap:9px;padding-left:10px;padding-right:10px}.composer-field{gap:5px;padding:0 9px}.composer-icon{min-width:25px;font-size:22px}.rupee{min-width:25px;width:25px;height:25px}.send-btn{width:48px;height:48px}.app-shell{display:flex;flex-direction:column;gap:14px;padding:0}.phone{width:100%;height:100dvh;min-height:520px;border:0;border-radius:0;order:0}.control-panel{width:calc(100% - 20px);max-height:none;overflow:visible;align-self:center;margin-bottom:18px;order:1;padding:18px}.topbar{padding-top:env(safe-area-inset-top);height:calc(66px + env(safe-area-inset-top))}.composer{padding-bottom:max(8px,env(safe-area-inset-bottom))}.panel-heading h1{font-size:23px}}@media(min-width:801px){.phone{position:sticky;top:22px}.control-panel{width:100%}}
